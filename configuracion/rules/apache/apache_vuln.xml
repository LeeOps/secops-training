<group name="apache_vuln,apache,web,">

  <!-- 100100 - Acceso a phpinfo.php -->
  <rule id="100100" level="5">
    <if_sid>31108</if_sid>
    <url type="pcre2">(?i)^/phpinfo\.php(?:\?.*)?$</url>
    <description>Apache vuln lab: peticion a phpinfo.php.</description>
    <group>apache_vuln,exposure,phpinfo,</group>
  </rule>

  <!-- 100101 - Acceso al formulario de subida -->
  <rule id="100101" level="7">
    <if_sid>31108</if_sid>
    <url type="pcre2">(?i)^/upload\.php(?:\?.*)?$</url>
    <description>Apache vuln lab: acceso al formulario de subida upload.php.</description>
    <group>apache_vuln,upload,access,</group>
  </rule>

  <!-- 100103 - Acceso a la carpeta de logs -->
  <rule id="100103" level="8">
    <if_sid>31108</if_sid>
    <url type="pcre2">(?i)^/logs(?:/|\?|$)</url>
    <description>Apache vuln lab: peticion a la carpeta de logs.</description>
    <group>apache_vuln,logs,exposure,</group>
  </rule>

  <!-- 100104 - Acceso al archivo de backup -->
  <rule id="100104" level="9">
    <if_sid>31108</if_sid>
    <url type="pcre2">(?i)^/backup_2023\.txt(?:\?.*)?$</url>
    <description>Apache vuln lab: peticion al archivo backup_2023.txt.</description>
    <group>apache_vuln,backup,exposure,</group>
  </rule>

  <!-- 100106 - Acceso a archivos PHP en uploads -->
  <rule id="100106" level="10">
    <if_sid>31108</if_sid>
    <url type="pcre2">(?i)^/uploads/[^?\s]+\.php(?:\?.*)?$</url>
    <description>Apache vuln lab: peticion a archivo PHP dentro de uploads.</description>
    <group>apache_vuln,uploads,webshell,</group>
  </rule>

</group>
