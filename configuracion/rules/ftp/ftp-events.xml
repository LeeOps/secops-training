<group name="ftp,vsftpd,authentication,access,">

  <!-- 83050 - Intento fallido de autenticacion FTP -->
  <rule id="83050" level="5">
    <if_sid>11403</if_sid>
    <description>FTP: intento fallido de autenticacion.</description>
    <group>ftp,authentication_failed,</group>
  </rule>

  <!-- 83051 - Cinco fallos desde la misma IP en 30 segundos -->
  <rule id="83051" level="7" frequency="5" timeframe="30">
    <if_matched_sid>83050</if_matched_sid>
    <same_srcip />
    <description>FTP: multiples intentos fallidos desde la misma IP.</description>
    <group>ftp,bruteforce,attack,</group>
  </rule>

  <!-- 83052 - Inicio de sesion FTP correcto -->
  <rule id="83052" level="3">
    <if_sid>11402</if_sid>
    <description>FTP: inicio de sesion correcto.</description>
    <group>ftp,authentication_success,</group>
  </rule>

  <!-- 83054 - Subida de archivos al servidor FTP -->
  <rule id="83054" level="5">
    <if_sid>11404</if_sid>
    <description>FTP: archivo subido al servidor.</description>
    <group>ftp,file_upload,</group>
  </rule>

  <!-- 83055 - Subida de archivos con extension potencialmente peligrosa -->
  <rule id="83055" level="8">
    <if_sid>83054</if_sid>
    <regex type="pcre2">(?i)\.(sh|php|py|exe|bat|pl|cgi)"?</regex>
    <description>FTP: subida de archivo con extension potencialmente peligrosa.</description>
    <group>ftp,suspicious_upload,</group>
  </rule>

</group>
