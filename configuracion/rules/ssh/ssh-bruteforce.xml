<group name="ssh,authentication,bruteforce,">

  <!-- 1. Intentos fallidos de autenticación -->
  <rule id="100200" level="5">
    <if_sid>5710,5760</if_sid>
    <description>SSH: intento de autenticacion fallido.</description>
    <group>ssh,authentication_failed,</group>
  </rule>

  <!-- 2. Cinco intentos fallidos en 60 segundos -->
  <rule id="100201" level="7" frequency="5" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <description>SSH: multiples fallos de autenticacion en 60 segundos.</description>
    <group>ssh,bruteforce,attack,</group>
  </rule>

  <!-- 3. Diez intentos desde la misma IP en 120 segundos -->
  <rule id="100202" level="10" frequency="10" timeframe="120">
    <if_matched_sid>100200</if_matched_sid>
    <same_srcip />
    <description>SSH: posibles intentos de fuerza bruta desde la misma IP.</description>
    <group>ssh,bruteforce,attack,critical,</group>
  </rule>

  <!-- 4. Autenticacion SSH correcta -->
  <rule id="100203" level="5">
    <if_sid>5715</if_sid>
    <description>SSH: autenticacion correcta.</description>
    <group>ssh,authentication_success,</group>
  </rule>

  <!-- 5. Inicio de sesion SSH como root -->
  <rule id="100204" level="8">
    <if_sid>5715</if_sid>
    <match>Accepted password for root</match>
    <description>SSH: autenticacion mediante contrasena del usuario root.</description>
    <group>ssh,root_access,authentication,</group>
  </rule>

</group>
